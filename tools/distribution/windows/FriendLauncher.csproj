<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ImmersiveMinecraftLauncher</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../launcher/FriendPack.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Management" Version="8.0.0" /></ItemGroup>
  <ItemGroup Condition="Exists('../release/release-pack.zip')">
    <EmbeddedResource Include="../release/release-pack.zip" LogicalName="ImmersiveMinecraft.Release" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../release/update-trust.json')"><EmbeddedResource Include="../release/update-trust.json" LogicalName="ImmersiveMinecraft.UpdateTrust" /></ItemGroup>
</Project>
